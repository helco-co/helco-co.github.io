# Apache config for the static site on InMotion (shared cPanel hosting).
# Ignored by GitHub Pages, which is not Apache.

# Serve our own 404 rather than the host's default.
ErrorDocument 404 /404.html

# Directory URLs like /en/services/ resolve to index.html inside them.
DirectoryIndex index.html

<IfModule mod_headers.c>
  # Hashed build assets never change contents, so cache them hard.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML must revalidate so content edits appear immediately.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Force HTTPS — the site is served over TLS and mixed access looks unprofessional.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>
