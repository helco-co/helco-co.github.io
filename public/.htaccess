# Force HTTPS so search engines don't index the plain-http version as a
# duplicate of every page. Skips the ACME challenge path so certificate
# renewal (served over plain HTTP) keeps working, and checks
# X-Forwarded-Proto too — if the InMotion cache layer ever terminates TLS
# in front of Apache, relying on %{HTTPS} alone here would redirect-loop
# every request.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Without this, Apache's own bare error page is what visitors see for a
# mistyped or dead link — GitHub Pages serves 404.html automatically by
# convention, but this host does not.
ErrorDocument 404 /404.html

# The host (InMotion) puts an nginx proxy cache in front of this site, and it
# caches exactly the URLs real visitors request — query-less ones. Anything
# with a query string is a cache MISS, which is what made this so hard to
# catch: every spot check with a cache-buster passed while phones were served
# a build hours old, still referencing the previous deploy's JS chunks.
#
# `no-cache, must-revalidate` alone did NOT stop it — the proxy stored and
# replayed the response anyway (observed: X-Proxy-Cache: HIT on a 90-minute-old
# homepage). nginx only ignores those directives when it is configured to;
# `no-store` and `private` are the two it refuses to cache under by default,
# so both are sent here, with Pragma/Expires for anything older in the chain.
#
# HTML is what changes every deploy, so it must never be stored. Everything
# Next.js fingerprints with a content hash can still be cached hard — a new
# build produces a new filename anyway.

<IfModule mod_headers.c>
  <FilesMatch "\.(html|json|txt)$">
    # X-Accel-Expires is nginx's own upstream cache control and outranks
    # Cache-Control in its cache decision. It is the only lever left here:
    # this proxy demonstrably ignores Cache-Control entirely — pages served
    # with `no-store` were still stored and replayed as X-Proxy-Cache: HIT.
    # nginx consumes this header and strips it, so clients never see it.
    Header set X-Accel-Expires "0"
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0, private"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <FilesMatch "\.(js|css|woff2|webp|svg|ico|png|jpg|jpeg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
